# Copy to .env.assistant (gitignored) for scripts/api.ts and the assistant skills.
# Create the token in the app under account → API tokens.
JOB_APPS_URL=https://jobs.example.com
JOB_APPS_TOKEN=jat_replace_me

# Optional, only for /stellenradar push messages (ntfy app on the phone).
# The topic is the only secret: make it long and random, e.g. `openssl rand -hex 16`,
# and subscribe to exactly that topic in the app.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
