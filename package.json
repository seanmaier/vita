{
  "name": "vita",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:all": "npm run seed && concurrently -n frontend,backend -c blue,magenta \"npm:dev\" \"npm:dev:server\"",
    "seed": "node --env-file-if-exists=.env server/seed.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "users": "node server/cli.ts",
    "api": "node scripts/api.ts",
    "lint": "oxlint",
    "test": "node scripts/vitest.ts run",
    "test:watch": "node scripts/vitest.ts",
    "test:coverage": "node scripts/vitest.ts run --coverage",
    "test:e2e": "vite build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "diff": "9.0.0",
    "hono": "^4.13.16",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
